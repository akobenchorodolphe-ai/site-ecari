# Base de donnees MySQL requise par Prisma.
# Remplacez ces valeurs par celles de votre environnement local ou d'hebergement.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ecari"

# Cle secrete longue et aleatoire pour signer les sessions du rectorat.
SESSION_SECRET="remplacez-par-une-cle-secrete-longue-et-aleatoire"

# URL publique de l'application, sans slash final.
APP_URL="http://localhost:3000"

# Repertoire de stockage local des candidatures et formulaires.
# En production serverless, remplacez ce stockage local par un stockage persistant.
STORAGE_DIR="storage"

# En production Netlify, laissez NETLIFY sélectionner automatiquement
# `netlify-blobs`. En local, conservez `local` (valeur par défaut).
STORAGE_BACKEND="local"

# Compte initial du rectorat, utilise uniquement par `npm run seed:admin`.
RECTORAT_SEED_EMAIL="rectorat@example.org"
RECTORAT_SEED_PASSWORD="changez-ce-mot-de-passe"

# Facultatif : code de verification Google Search Console.
GOOGLE_SITE_VERIFICATION=""

# Facultatif : URL Google Form alternative pour l'inscription CERAO.
NEXT_PUBLIC_CERAO_GOOGLE_FORM_URL=""
